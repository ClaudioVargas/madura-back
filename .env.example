# ============================================================
# Configuración de Madura Back
# Copia este archivo a `.env` y ajusta los valores.
# En producción, establece SECRET_KEY a un valor seguro y único.
# ============================================================

# Proyecto
PROJECT_NAME=madura_back

# Seguridad JWT
SECRET_KEY=dev-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440          # 1 día
REFRESH_TOKEN_EXPIRE_MINUTES=10080        # 7 días

# Modelo de Machine Learning
MODEL_PATH=app/models/modelo_platano.keras

# Base de datos (SQLite local; en Docker se usa sqlite:////data/madura.db)
DATABASE_URL=sqlite:///database.db

# Orígenes CORS permitidos (separados por comas)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://madura-front.onrender.com

# Rate limiting de login (intentos fallidos por IP)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900             # 15 minutos